#include <iostream>
#include <iomanip>
#include <cmath>

using namespace std;

int main() {
    int m, n;
    cin >> m >> n;

    double a[10][12];
    for (int i = 0; i < m; ++i) {
        for (int j = 0; j < n; ++j) {
            cin >> a[i][j];
        }
    }

    for (int i = 0; i < m; ++i) {
        double s = 0.0;
        for (int j = 0; j < n; ++j) {
            s += log(fabs(a[i][j]));
        }
        double g = exp(s / n);

        double d = a[i][0];
        double r = fabs(d - g);
        for (int j = 1; j < n; ++j) {
            double c = fabs(a[i][j] - g);
            if (c > r) {
                r = c;
                d = a[i][j];
            }
        }

        for (int j = 0; j < n; ++j) {
            cout << setw(10) << a[i][j] << " ";
        }
        cout << " | " << setw(10) << d << " " << endl;
    }

    int k;
    cin >> k;

    double b[10][10];
    for (int i = 0; i < k; ++i) {
        for (int j = 0; j < k; ++j) {
            cin >> b[i][j];
        }
    }

    double sum_above = 0.0;
    double sum_below = 0.0;

    for (int i = 0; i < k; ++i) {
        for (int j = 0; j < k; ++j) {
            if (j > i) {
                sum_above += b[i][j];
            } else if (j < i) {
                sum_below += b[i][j];
            }
        }
    }

    for (int i = 0; i < k; ++i) {
        for (int j = 0; j < k; ++j) {
            cout << setw(10) << b[i][j] << " ";
        }
        cout << endl;
    }

    cout << "Above: " << setw(10) << sum_above << endl;
    cout << "Below: " << setw(10) << sum_below << endl;

    if (sum_above > sum_below) {
        cout << "Max: " << setw(10) << sum_above << endl;
    } else if (sum_below > sum_above) {
        cout << "Max: " << setw(10) << sum_below << endl;
    } else {
        cout << "Equal: " << setw(10) << sum_above << endl;
    }

    return 0;
}
